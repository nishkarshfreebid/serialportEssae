<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ============ Scale connection status / controls ============ -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No device connected"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <Spinner
            android:id="@+id/baudSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear Log" />
    </LinearLayout>

    <!-- ============ RFID status row ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/rfidStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RFID: idle"
            android:textSize="13sp" />

        <Button
            android:id="@+id/rfidToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Scan" />
    </LinearLayout>

    <!-- ============ Match / Mismatch verdict card ============ -->
    <LinearLayout
        android:id="@+id/verdictCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/status_unknown"
        android:padding="14dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/verdictLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AWAITING TAG"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/itemNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item: —"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:paddingTop="10dp" />

        <TextView
            android:id="@+id/skuText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SKU: —"
            android:textColor="#DDDDDD"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/epcText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EPC: —"
            android:textColor="#DDDDDD"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/stockText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In stock: —"
            android:textColor="#DDDDDD"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:text="Expected weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/expectedWeightText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:text="Scale reading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/liveWeightText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/resetScanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Reset / Clear Scan" />

    </LinearLayout>

    <!-- ============ Raw serial log (diagnostics) ============ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Raw scale data"
        android:textStyle="bold"
        android:textSize="13sp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/dataText"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#111111"
        android:fontFamily="monospace"
        android:textColor="#00FF00"
        android:textSize="12sp"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:text="" />

    <!-- ============ Send row (manual commands to scale) ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/sendEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type data to send..." />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send" />
    </LinearLayout>

</LinearLayout>
</ScrollView>

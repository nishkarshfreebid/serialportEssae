<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5EF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:background="#210B18">

            <!-- BRAND -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦  Lipi"
                    android:textColor="#E7C66A"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="       JEWELLERS"
                    android:textColor="#E7C66A"
                    android:textSize="14sp"
                    android:letterSpacing="0.35" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRUST  •  PURITY  •  TRADITION"
                    android:textColor="#D8C6A0"
                    android:textSize="9sp"
                    android:letterSpacing="0.15" />

            </LinearLayout>

            <!-- TITLE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RFID JEWELLERY VERIFICATION"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Tag Auto Scanning &amp; Weight Verification"
                    android:textColor="#E7C66A"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- TIME -->
            <LinearLayout
                android:layout_width="190dp"
                android:layout_height="65dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#2D1422"
                android:padding="8dp">

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:53:30 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="02 Sep 2026"
                    android:textColor="#DDDDDD"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- RFID TOP STATUS BAR -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_margin="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#FFFFFF">

            <!-- RFID -->
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="◉"
                    android:textColor="#B8860B"
                    android:textSize="34sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RFID READER"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rfidStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="● Connected"
                        android:textColor="#2E7D32"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- DIVIDER -->
            <View
                android:layout_width="1dp"
                android:layout_height="52dp"
                android:background="#DDD4C4" />

            <!-- EPC -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAST SCANNED EPC"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/epcText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="—"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true" />

            </LinearLayout>

            <!-- STATUS -->
            <LinearLayout
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCAN STATUS"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="● Ready"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- CLEAR -->
            <Button
                android:id="@+id/clearButton"
                android:layout_width="115dp"
                android:layout_height="48dp"
                android:text="CLEAR"
                android:textStyle="bold"
                android:textColor="#4B3510"
                android:backgroundTint="#E5C675" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- RFID SCAN BUTTON -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/rfidToggleButton"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:text="START RFID SCAN"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3B1729" />

            <Spinner
                android:id="@+id/baudSpinner"
                android:layout_width="170dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="130dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="SCALE CONNECT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#E5C675"
                android:textColor="#3D2A0B" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- MAIN TWO COLUMN AREA -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:orientation="horizontal">

            <!-- ===================================================== -->
            <!-- LEFT : PRODUCT DETAILS -->
            <!-- ===================================================== -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#FFFFFF">

                <!-- TITLE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="✦"
                        android:textColor="#B8860B"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="PRODUCT DETAILS"
                        android:textColor="#321624"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DED4C5" />

                <!-- PRODUCT VISUAL -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="145dp"
                        android:layout_height="145dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#2A0D1B">

                        <ImageView
                            android:id="@+id/jewelleryImageView"
                            android:layout_width="125dp"
                            android:layout_height="125dp"
                            android:contentDescription="Jewellery Image"
                            android:scaleType="fitCenter"
                            android:src="@drawable/noimage" />

                    </LinearLayout>

                    <!-- DETAILS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="20dp">

                        <TextView
                            android:id="@+id/itemNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Name: —"
                            android:textColor="#222222"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/itemTypeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Type: —"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/materialText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Material: —"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/purityText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Purity: —"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- EPC -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="EPC / TAG ID"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/epcDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="EPC shown above"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />


                <!-- EXPECTED WEIGHT -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:background="#F5EFE3">

                    <TextView
                        android:id="@+id/expectedWeightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Expected Weight: —"
                        android:textColor="#6A4B0C"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- CLEAR -->

                <Button
                    android:id="@+id/resetScanButton"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="14dp"
                    android:text="CLEAR CURRENT TAG"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#3B1729"
                    android:textColor="#FFFFFF" />

            </LinearLayout>


            <!-- ===================================================== -->
            <!-- DIVIDER -->
            <!-- ===================================================== -->

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent"
                android:background="#F8F5EF" />


            <!-- ===================================================== -->
            <!-- RIGHT : WEIGHT VERIFICATION -->
            <!-- ===================================================== -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#FFFFFF">

                <!-- TITLE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="⚖"
                        android:textColor="#B8860B"
                        android:textSize="27sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="WEIGHT VERIFICATION"
                        android:textColor="#321624"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DED4C5" />


                <!-- WEIGHT BOXES -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- EXPECTED -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#FCFAF5">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXPECTED WEIGHT"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/expectedWeightLargeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="—"
                            android:textColor="#31813A"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="grams"
                            android:textColor="#555555"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <!-- GAP -->

                    <View
                        android:layout_width="10dp"
                        android:layout_height="match_parent"
                        android:background="#F8F5EF" />


                    <!-- RECEIVED -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#FCFAF5">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RECEIVED WEIGHT"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/liveWeightText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="—"
                            android:textColor="#31813A"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="grams"
                            android:textColor="#555555"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <!-- GAP -->

                    <View
                        android:layout_width="10dp"
                        android:layout_height="match_parent"
                        android:background="#F8F5EF" />


                    <!-- RESULT -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#FCFAF5">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VERIFICATION RESULT"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/resultText"
                            android:layout_width="150dp"
                            android:layout_height="58dp"
                            android:layout_marginTop="17dp"
                            android:gravity="center"
                            android:text="WAITING"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:background="#777777" />

                        <TextView
                            android:id="@+id/differenceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Difference: —"
                            android:textColor="#444444"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <!-- TOLERANCE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#F5EFE3">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Allowed Tolerance"
                        android:textColor="#444444"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="± 2.000 g"
                        android:textColor="#6A4B0C"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="155dp"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="15dp"
                    android:background="#FCFAF5">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚖  SCALE STATUS"
                        android:textColor="#321624"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="#DED4C5" />

                    <TextView
                        android:id="@+id/scaleConnectionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="● SCALE CONNECTED"
                        android:textColor="#2E7D32"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/scaleLargeWeightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="— g"
                        android:textColor="#111111"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/scaleStableText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="〰 Stable"
                        android:textColor="#2E7D32"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- MULTIPLE SCANNED JEWELLERY -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="#B8860B"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="SCANNED JEWELLERY"
                    android:textColor="#321624"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DED4C5" />

            <TextView
                android:id="@+id/scannedTagsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="80dp"
                android:padding="12dp"
                android:text="No tags scanned"
                android:textColor="#333333"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:background="#F7F4EE" />

        </LinearLayout>


    </LinearLayout>

</ScrollView>